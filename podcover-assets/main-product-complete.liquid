{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign initial_image = selected_variant.featured_image | default: product.featured_image
  assign product_name = product.title | downcase
  assign is_blue_cloud = false
  assign is_colour_edit = false
  if product_name contains 'blue cloud' or product.handle contains 'blue-cloud'
    assign is_blue_cloud = true
  elsif product_name contains 'colour edit' or product.handle contains 'colour-edit'
    assign is_colour_edit = true
  endif
  assign form_id = 'PodCoverForm-' | append: section.id
  assign shipping_url = shop.shipping_policy.url | default: '/policies/shipping-policy'
  assign refund_url = shop.refund_policy.url | default: '/policies/refund-policy'
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign saving_percent = 0
  if selected_variant.compare_at_price > selected_variant.price
    assign saving_percent = selected_variant.compare_at_price | minus: selected_variant.price | times: 100 | divided_by: selected_variant.compare_at_price | floor
  endif
  assign selected_maximum = selected_variant.quantity_rule.max
  if selected_variant.inventory_management != blank and selected_variant.inventory_policy == 'deny'
    assign selected_inventory = selected_variant.inventory_quantity | at_least: 0
    if selected_maximum == blank or selected_inventory < selected_maximum
      assign selected_maximum = selected_inventory
    endif
  endif
%}

<section id="PodCoverProduct-{{ section.id }}" class="pc-product" data-pc-product style="--pc-stage: {{ section.settings.image_background | default: '#f3f0e8' }};" aria-labelledby="pc-title-{{ section.id }}">
  <div class="pc-wrap">
    <nav class="pc-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a><span aria-hidden="true">/</span>
      <a href="{{ routes.all_products_collection_url }}">The collection</a><span aria-hidden="true">/</span>
      <span>{{ product.title | escape }}</span>
    </nav>
    <div class="pc-layout">
      <div class="pc-gallery">
        <div class="pc-gallery-top">
          <div class="pc-photo">
            <span class="pc-photo-label">{% if is_blue_cloud %}THE BLUE CLOUD EDIT{% elsif is_colour_edit %}THE COLOUR EDIT{% else %}THE PODCOVER EDIT{% endif %}</span>
            {% if initial_image %}
              {% assign initial_alt = initial_image.alt | default: product.title %}
              {{ initial_image | image_url: width: 1400 | image_tag: class: 'pc-main-image', loading: 'eager', fetchpriority: 'high', widths: '320, 480, 700, 1000, 1400', sizes: '(min-width: 1000px) 42vw, (min-width: 761px) 70vw, 76vw', alt: initial_alt }}
            {% else %}
              <div class="pc-photo-empty"><svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><rect x="7" y="9" width="34" height="30" rx="5"/><circle cx="18" cy="19" r="3"/><path d="m9 33 10-9 8 7 6-6 7 8"/></svg><p>Product photos coming soon.</p></div>
            {% endif %}
            <span class="pc-photo-index"><span data-pc-photo-index>01</span><span aria-hidden="true"> / </span>{{ product.images.size | at_least: 1 }}</span>
          </div>
          <div class="pc-benefit-rail" aria-label="Product highlights">
            <div class="pc-rail-card"><svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><rect x="8" y="12" width="24" height="21" rx="7"/><path d="M8 21h24M14 8V5m12 3V5M4 15H1m38 0h-3m-19 12 2 2 5-5"/></svg><span>Made for<br>your model</span></div>
            <div class="pc-rail-card"><svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><circle cx="14" cy="15" r="8"/><circle cx="27" cy="15" r="8"/><circle cx="20" cy="27" r="8"/></svg><span>{% if is_blue_cloud %}Cloudlike<br>colour{% else %}Your colour.<br>Your style.{% endif %}</span></div>
            <div class="pc-rail-card"><svg viewBox="0 0 40 40" fill="none" aria-hidden="true"><path d="m18 22 4-4M14 26l-2 2a6 6 0 0 1-8-8l7-7a6 6 0 0 1 8 0M26 14l2-2a6 6 0 0 1 8 8l-7 7a6 6 0 0 1-8 0"/></svg><span>{% if is_blue_cloud %}Silver chain<br>detail{% elsif is_colour_edit %}Clip it.<br>Take it.{% else %}Small detail.<br>Big feeling.{% endif %}</span></div>
          </div>
        </div>
        {% if product.images.size > 1 %}
          <div class="pc-thumbnails" role="group" aria-label="Choose a product photo">
            {% for image in product.images %}
              <button class="pc-thumbnail{% if image.id == initial_image.id %} is-active{% endif %}" type="button" data-pc-image-id="{{ image.id }}" aria-label="View photo {{ forloop.index }}" aria-pressed="{% if image.id == initial_image.id %}true{% else %}false{% endif %}">{{ image | image_url: width: 160 | image_tag: loading: 'lazy', widths: '80, 160', sizes: '64px', alt: '' }}</button>
            {% endfor %}
          </div>
        {% endif %}
        <p class="pc-gallery-note">A SMALL DETAIL. AN EVERYDAY STATEMENT.</p>
      </div>

      <div class="pc-purchase">
        <div class="pc-intro-line"><span class="pc-eyebrow">PODCOVER / MADE TO EXPRESS YOU</span>{% if section.settings.show_free_shipping %}<span class="pc-shipping-tag"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 5h11v12H3zM14 9h4l3 4v4h-7"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>Free shipping</span>{% endif %}</div>
        {% if section.settings.show_reviews and rating != blank and rating_count > 0 %}
          {% assign star_width = rating.rating | times: 100.0 | divided_by: rating.scale_max %}
          <div class="pc-rating" aria-label="Rated {{ rating.rating }} out of {{ rating.scale_max }}, based on {{ rating_count }} reviews"><span class="pc-stars" aria-hidden="true"><span>★★★★★</span><span style="width: {{ star_width }}%;">★★★★★</span></span><strong>{{ rating.rating }}/{{ rating.scale_max }}</strong><span>{{ rating_count }} {% if rating_count == 1 %}review{% else %}reviews{% endif %}</span></div>
        {% endif %}
        <h1 id="pc-title-{{ section.id }}">{{ product.title | escape }}</h1>
        <p class="pc-subtitle">{% if section.settings.subtitle != blank %}{{ section.settings.subtitle | escape }}{% elsif is_blue_cloud %}A little piece of sky. A little silver shine. All you.{% elsif is_colour_edit %}Your favourite shade, now part of your everyday.{% else %}A fresh look for your everyday essential. Make it yours.{% endif %}</p>
        <div class="pc-price-row" aria-live="polite" aria-atomic="true"><strong data-pc-price>{{ selected_variant.price | money }}</strong><s data-pc-compare{% unless selected_variant.compare_at_price > selected_variant.price %} hidden{% endunless %}>{% if selected_variant.compare_at_price > selected_variant.price %}{{ selected_variant.compare_at_price | money }}{% endif %}</s><span class="pc-sale" data-pc-saving{% unless saving_percent > 0 %} hidden{% endunless %}>Save {{ saving_percent }}%</span></div>
        <div class="pc-feature-grid">
          <div><span class="pc-feature-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 12 4 4L19 6"/></svg></span><span>{% if is_blue_cloud %}Glossy cloud-blue finish{% elsif is_colour_edit %}Four everyday shades{% else %}Your everyday, upgraded{% endif %}</span></div>
          <div><span class="pc-feature-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 15 6-6M7 17l-1 1a4 4 0 0 1-6-6l5-5a4 4 0 0 1 6 0M17 7l1-1a4 4 0 0 1 6 6l-5 5a4 4 0 0 1-6 0" transform="translate(2 2) scale(.83)"/></svg></span><span>{% if is_blue_cloud %}Silver ball-chain accent{% elsif is_colour_edit %}Carabiner detail{% else %}A small style statement{% endif %}</span></div>
          <div><span class="pc-feature-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="5" width="16" height="15" rx="5"/><path d="M4 12h16m-8 4h.01"/></svg></span><span>Choose your AirPods fit</span></div>
          <div><span class="pc-feature-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m12 3 8 4v5c0 5-8 9-8 9s-8-4-8-9V7l8-4Z"/><path d="m8 12 3 3 5-6"/></svg></span><span>Secure Shopify checkout</span></div>
        </div>

        {% form 'product', product, id: form_id, class: 'pc-product-form' %}
          <div class="pc-native-option"><label for="pc-variant-{{ section.id }}">{% if product.has_only_default_variant %}Product{% else %}Choose your model and colour{% endif %}</label><select name="id" id="pc-variant-{{ section.id }}" data-pc-variant required>{% for variant in product.variants %}<option value="{{ variant.id }}"{% if variant.id == selected_variant.id %} selected{% endif %}>{% for variant_option in variant.options %}{{ variant_option | replace: '(only for 2 pro)', '' | replace: '(only for the 2 pro)', '' | strip | escape }}{% unless forloop.last %} / {% endunless %}{% endfor %} — {{ variant.price | money }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select></div>
          {% unless product.has_only_default_variant %}
            <div class="pc-enhanced-options" hidden>
              {% for option in product.options_with_values %}
                {% liquid
                  assign option_index = option.position | minus: 1
                  assign option_name = option.name | downcase
                  assign is_colour_option = false
                  if option_name contains 'colour' or option_name contains 'color' or option_name contains 'farve'
                    assign is_colour_option = true
                  endif
                %}
                <div class="pc-option-group" data-pc-option-index="{{ option_index }}">
                  <div class="pc-option-heading"><span>{{ option.name | escape }}</span><span data-pc-option-value>{{ selected_variant.options[option_index] | replace: '(only for 2 pro)', '' | replace: '(only for the 2 pro)', '' | strip | escape }}</span></div>
                  <div class="pc-option-values{% if is_colour_option %} pc-colour-values{% endif %}" role="group" aria-label="{{ option.name | escape }}">
                    {% for value in option.values %}
                      {% liquid
                        assign value_name = value.name | default: value
                        assign value_label = value_name | replace: '(only for 2 pro)', '' | replace: '(only for the 2 pro)', '' | strip
                        assign value_lower = value_label | downcase
                        assign swatch_colour = ''
                        case value_lower
                          when 'matcha green', 'matcha', 'green'
                            assign swatch_colour = '#85967a'
                          when 'black'
                            assign swatch_colour = '#242526'
                          when 'white'
                            assign swatch_colour = '#ffffff'
                          when 'lavender'
                            assign swatch_colour = '#b9a7cd'
                          when 'blue', 'blue cloud'
                            assign swatch_colour = '#7bbfe8'
                        endcase
                      %}
                      <button type="button" class="pc-option{% if selected_variant.options[option_index] == value_name %} is-active{% endif %}" data-pc-option="{{ value_name | escape }}" aria-pressed="{% if selected_variant.options[option_index] == value_name %}true{% else %}false{% endif %}">{% if is_colour_option and swatch_colour != blank %}<span class="pc-swatch" style="background: {{ swatch_colour }};" aria-hidden="true"></span>{% endif %}<span>{{ value_label | escape }}</span></button>
                    {% endfor %}
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endunless %}
          <div class="pc-quantity-line"><label for="pc-quantity-{{ section.id }}">Quantity</label><div class="pc-quantity"><button type="button" data-pc-minus aria-label="Decrease quantity">−</button><input id="pc-quantity-{{ section.id }}" type="number" name="quantity" value="{{ selected_variant.quantity_rule.min | default: 1 }}" min="{{ selected_variant.quantity_rule.min | default: 1 }}" step="{{ selected_variant.quantity_rule.increment | default: 1 }}"{% if selected_maximum != blank %} max="{{ selected_maximum }}"{% endif %} inputmode="numeric" required><button type="button" data-pc-plus aria-label="Increase quantity">+</button></div><span class="pc-stock" data-pc-stock role="status"><span aria-hidden="true"></span>{% if selected_variant.available %}In stock{% else %}Sold out{% endif %}</span></div>
          {% if section.settings.show_dispatch_countdown %}
            <div class="pc-dispatch" data-pc-dispatch data-cutoff-hour="{{ section.settings.dispatch_cutoff_hour }}" hidden>
              <span class="pc-dispatch-icon"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="13" r="8"/><path d="M12 9v5l3 2M9 3h6"/></svg></span>
              <p><span data-pc-dispatch-lead>Order within</span> <strong data-pc-dispatch-time>--:--:--</strong> <span data-pc-dispatch-result>and we'll dispatch it today.</span></p>
            </div>
          {% endif %}
          <p class="pc-fit-note">Check your AirPods model before ordering. Each case fits the model you select.</p>
          <button class="pc-add" type="submit" data-pc-add{% unless product.available %} disabled{% endunless %}><span data-pc-add-label>{% if product.available %}Add to cart{% else %}Sold out{% endif %}</span><span class="pc-add-prices"><span data-pc-add-price>{{ selected_variant.price | money }}</span><s data-pc-add-compare{% unless selected_variant.compare_at_price > selected_variant.price %} hidden{% endunless %}>{% if selected_variant.compare_at_price > selected_variant.price %}{{ selected_variant.compare_at_price | money }}{% endif %}</s></span><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></button>
          <div class="pc-form-result" hidden><p class="pc-form-message" data-pc-message role="status" aria-live="polite"></p><a href="{{ routes.cart_url }}" data-pc-view-cart hidden>View your bag ↗</a></div>
        {% endform %}
        <div class="pc-assurance"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 3 3 5-6"/></svg><span>{% if section.settings.show_free_shipping %}Free standard shipping{% else %}Secure Shopify checkout{% endif %}</span><span aria-hidden="true">·</span><a href="{{ refund_url }}">Returns &amp; refunds</a></div>
        {% if section.settings.show_trustpilot and section.settings.trustpilot_url != blank %}
          <a class="pc-trustpilot" href="{{ section.settings.trustpilot_url }}" target="_blank" rel="noopener noreferrer" aria-label="View PodCover on Trustpilot">
            <span class="pc-trustpilot-brand"><span aria-hidden="true">★</span><strong>Trustpilot</strong></span>
            <span class="pc-trustpilot-copy">{% if section.settings.trustpilot_score != blank and section.settings.trustpilot_review_count != blank %}TrustScore {{ section.settings.trustpilot_score | escape }} <span aria-hidden="true">·</span> {{ section.settings.trustpilot_review_count | escape }} reviews{% else %}View our Trustpilot profile{% endif %}</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg>
          </a>
        {% endif %}
        <div class="pc-accordions">
          <details><summary>The details<span aria-hidden="true">+</span></summary><div class="pc-detail-copy">{% if product.description != blank %}{{ product.description }}{% elsif is_blue_cloud %}<p>A cloud-inspired blue finish with a glossy look and a silver ball-chain accent. A little colour for your everyday.</p>{% elsif is_colour_edit %}<p>Meet your everyday colour edit: Matcha Green, Black, White and Lavender. Available colours depend on your selected AirPods model.</p>{% else %}<p>A case for your everyday essential. Choose your available model and colour above.</p>{% endif %}</div></details>
          <details><summary>Finding your fit<span aria-hidden="true">+</span></summary><div class="pc-detail-copy"><p>Check your AirPods model in your device settings before choosing a case. Different AirPods models have different case dimensions.</p><p>Only the combinations offered above are available. This product is an accessory case; AirPods and the charging case are not included.</p></div></details>
          <details><summary>Shipping &amp; returns<span aria-hidden="true">+</span></summary><div class="pc-detail-copy"><p>{% if section.settings.show_free_shipping %}Standard shipping is free. {% endif %}Read our <a href="{{ shipping_url }}">shipping policy</a> for delivery information.</p><p>Consumers in Denmark and the EU generally have a 14-day cancellation period. Conditions and exceptions apply. Read our <a href="{{ refund_url }}">return and refund policy</a> before sending a return.</p></div></details>
        </div>
        <p class="pc-help">Need a hand? <a href="mailto:podcoverhelp@gmail.com">Ask PodCover <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a></p>
      </div>
    </div>
    <div class="pc-everyday"><div><span class="pc-eyebrow">SMALL CASE. BIG PERSONALITY.</span><h2>Your everyday.<br>A little more <em>you.</em></h2></div><div class="pc-everyday-steps"><div><span>01</span><strong>Find your fit.</strong><p>Choose the case for your AirPods model.</p></div><div><span>02</span><strong>Make it yours.</strong><p>A little colour. A little character.</p></div><div><span>03</span><strong>Take it along.</strong><p>For your playlists and everything in between.</p></div></div><a class="pc-collection-link" href="{{ routes.all_products_collection_url }}">Explore the collection <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 18 18 6M6 6h12v12"/></svg></a></div>
  </div>

  <script type="application/json" data-pc-config>
    {
      "selectedId": {{ selected_variant.id | append: '' | json }},
      "initialImageId": {{ initial_image.id | append: '' | json }},
      "fallbackImageId": {{ product.featured_image.id | append: '' | json }},
      "addUrl": {{ routes.cart_add_url | append: '.js' | json }},
      "cartUrl": {{ routes.cart_url | json }},
      "variants": [
        {% for variant in product.variants %}
          {% liquid
            assign maximum_quantity = variant.quantity_rule.max
            if variant.inventory_management != blank and variant.inventory_policy == 'deny'
              assign inventory_maximum = variant.inventory_quantity | at_least: 0
              if maximum_quantity == blank or inventory_maximum < maximum_quantity
                assign maximum_quantity = inventory_maximum
              endif
            endif
            assign variant_saving = 0
            if variant.compare_at_price > variant.price
              assign variant_saving = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price | floor
            endif
          %}
          {"id": {{ variant.id | append: '' | json }}, "options": {{ variant.options | json }}, "available": {{ variant.available | json }}, "price": {{ variant.price | money | json }}, "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %}, "saving": {{ variant_saving | json }}, "imageId": {% if variant.featured_image %}{{ variant.featured_image.id | append: '' | json }}{% else %}null{% endif %}, "min": {{ variant.quantity_rule.min | default: 1 | json }}, "step": {{ variant.quantity_rule.increment | default: 1 | json }}, "max": {% if maximum_quantity != blank %}{{ maximum_quantity | json }}{% else %}null{% endif %}}{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ],
      "images": [
        {% for image in product.images %}
          {"id": {{ image.id | append: '' | json }}, "src": {{ image | image_url: width: 1400 | json }}, "alt": {{ image.alt | default: product.title | json }}, "width": {{ image.width | json }}, "height": {{ image.height | json }}, "index": {{ forloop.index }}}{% unless forloop.last %},{% endunless %}
        {% endfor %}
      ]
    }
  </script>
</section>

<style>
  .pc-product{--pc-ink:#202321;--pc-muted:#71756f;--pc-line:#e3e5de;--pc-green:#6b7d61;color:var(--pc-ink);background:#fff;font-family:Manrope,'DM Sans',Arial,sans-serif}
  .pc-product *,.pc-product *::before,.pc-product *::after{box-sizing:border-box}
  .pc-product [hidden]{display:none!important}
  .pc-product a{color:inherit;text-decoration:none}
  .pc-product :where(button,input,select){font:inherit}
  .pc-product button{cursor:pointer}.pc-product button:disabled{cursor:not-allowed}
  .pc-product svg{display:block;stroke:currentColor;stroke-width:1.65;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
  .pc-product h1,.pc-product h2,.pc-product p{margin:0}
  .pc-product button:focus-visible,.pc-product a:focus-visible,.pc-product input:focus-visible,.pc-product select:focus-visible,.pc-product summary:focus-visible{outline:2px solid #6b7d61;outline-offset:4px}
  .pc-wrap{max-width:1320px;margin:0 auto;padding:0 5% 76px}
  .pc-breadcrumb{display:flex;align-items:center;flex-wrap:wrap;gap:9px;padding:24px 0 28px;color:var(--pc-muted);font-size:11px;line-height:1.6}.pc-breadcrumb>a:hover{text-decoration:underline;text-underline-offset:3px}.pc-breadcrumb>span:last-child{overflow-wrap:anywhere}
  .pc-layout{display:grid;grid-template-columns:minmax(0,1.17fr) minmax(0,1fr);gap:clamp(28px,4vw,62px);align-items:start}
  .pc-gallery{min-width:0;position:sticky;top:104px}.pc-gallery-top{display:grid;grid-template-columns:minmax(0,1fr) 105px;gap:10px}
  .pc-photo{background:var(--pc-stage);aspect-ratio:1;position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:22px}
  .pc-main-image{display:block;max-width:100%;width:100%;height:100%;object-fit:contain;object-position:center}
  .pc-photo-label{position:absolute;z-index:1;left:15px;top:15px;max-width:calc(100% - 30px);padding:8px 11px;background:#fffdf8ed;border:1px solid #fff6;border-radius:8px;font-size:9px;font-weight:700;letter-spacing:.12em;line-height:1.5}
  .pc-photo-index{position:absolute;right:15px;bottom:14px;padding:6px 9px;border-radius:20px;background:#ffffffc9;font-size:10px;letter-spacing:.05em}
  .pc-photo-empty{padding:35px 20px;display:grid;justify-items:center;gap:15px;color:var(--pc-muted);font-size:12px;text-align:center}.pc-photo-empty svg{width:50px;height:50px}
  .pc-benefit-rail{display:grid;grid-template-rows:repeat(3,minmax(0,1fr));gap:10px;min-width:0}
  .pc-rail-card{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:13px;padding:14px 8px;background:var(--pc-stage);border-radius:17px;text-align:center}.pc-rail-card:nth-child(2){background:#eef0e9}.pc-rail-card:nth-child(3){background:#f0edf3}.pc-rail-card svg{width:35px;height:35px;stroke-width:1.9}.pc-rail-card span{font-size:11px;font-weight:650;line-height:1.45}
  .pc-thumbnails{display:flex;gap:9px;overflow:auto;padding:13px 2px 4px;scrollbar-width:thin}.pc-thumbnail{flex:0 0 64px;width:64px;height:64px;background:#f5f4ef;border:1px solid var(--pc-line);padding:3px;border-radius:11px;transition:border-color .2s}.pc-thumbnail.is-active{border-color:var(--pc-ink);box-shadow:inset 0 0 0 1px var(--pc-ink)}.pc-thumbnail img{display:block;width:100%;height:100%;object-fit:contain;border-radius:7px}.pc-gallery-note{font-size:9px;letter-spacing:.14em;color:var(--pc-muted);padding-top:16px;line-height:1.6}
  .pc-purchase{min-width:0;padding-top:2px}.pc-intro-line{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px}.pc-eyebrow{font-size:9px;font-weight:700;letter-spacing:.13em;line-height:1.6}
  .pc-shipping-tag{display:inline-flex;align-items:center;gap:6px;padding:6px 9px;background:#eef2eb;color:#526449;border-radius:20px;font-size:10px;font-weight:650;white-space:nowrap}.pc-shipping-tag svg{width:16px;height:16px}
  .pc-rating{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-bottom:10px;font-size:11px;color:var(--pc-muted)}.pc-rating strong{color:var(--pc-ink)}.pc-stars{position:relative;font-size:16px;letter-spacing:1px;color:#dcded7}.pc-stars>span:nth-child(2){position:absolute;left:0;top:0;overflow:hidden;white-space:nowrap;color:#718562}
  .pc-purchase h1{font-size:clamp(29px,3.25vw,43px);font-weight:700;letter-spacing:-.055em;line-height:1.1;overflow-wrap:anywhere;margin:0 0 12px}.pc-subtitle{font-size:13px;line-height:1.7;color:var(--pc-muted);max-width:390px}
  .pc-price-row{display:flex;align-items:center;flex-wrap:wrap;gap:12px;margin:20px 0}.pc-price-row>strong{font-size:25px;font-weight:750;letter-spacing:-.04em}.pc-price-row>s{font-size:15px;color:#82857e}.pc-sale{padding:6px 10px;background:var(--pc-ink);color:#fff;border-radius:20px;font-size:11px;font-weight:650}
