</style>

<script>
  (() => {
    'use strict';
    if (!window.PodCoverProductInit) {
      window.PodCoverProductInit = root => {
        if (!root || root.dataset.pcInitialized) return;
        let config;
        try { config = JSON.parse(root.querySelector('[data-pc-config]').textContent); } catch (_) { return; }
        const form = root.querySelector('.pc-product-form');
        const variantSelect = root.querySelector('[data-pc-variant]');
        if (!form || !variantSelect) return;
        const groups = [...root.querySelectorAll('[data-pc-option-index]')];
        const quantity = form.querySelector('[name="quantity"]');
        const addButton = root.querySelector('[data-pc-add]');
        const result = root.querySelector('.pc-form-result');
        const message = root.querySelector('[data-pc-message]');
        const bagLink = root.querySelector('[data-pc-view-cart]');
        let selected = config.variants.find(v => v.id === config.selectedId) || config.variants[0];
        if (!selected) return;
        let optionValues = [...selected.options];
        let busy = false;
        root.dataset.pcInitialized = 'true';
        const mainImage = root.querySelector('.pc-main-image');
        if (mainImage) mainImage.dataset.pcImageId = config.initialImageId;

        function showImage(id) {
          const photo = config.images.find(img => img.id === String(id));
          if (!photo || !mainImage) return;
          if (mainImage.dataset.pcImageId !== photo.id) {
            mainImage.removeAttribute('srcset');
            mainImage.src = photo.src;
            mainImage.alt = photo.alt;
            mainImage.width = photo.width;
            mainImage.height = photo.height;
            mainImage.dataset.pcImageId = photo.id;
          }
          root.querySelector('[data-pc-photo-index]').textContent = String(photo.index).padStart(2, '0');
          root.querySelectorAll('.pc-thumbnail').forEach(button => {
            const active = button.dataset.pcImageId === photo.id;
            button.classList.toggle('is-active', active);
            button.setAttribute('aria-pressed', String(active));
          });
        }
        function clearMessage() { result.hidden = true; result.classList.remove('is-error'); message.textContent = ''; bagLink.hidden = true; }
        function setMessage(text, error = false) { result.hidden = false; result.classList.toggle('is-error', error); message.textContent = text; }
        function normaliseQuantity() {
          const minimum = Number(quantity.min) || 1;
          const step = Number(quantity.step) || 1;
          const maximum = quantity.hasAttribute('max') ? Number(quantity.max) : Infinity;
          let amount = Number(quantity.value);
          if (!Number.isFinite(amount)) amount = minimum;
          amount = minimum + Math.round((amount - minimum) / step) * step;
          const validMaximum = Number.isFinite(maximum) ? minimum + Math.floor((maximum - minimum) / step) * step : Infinity;
          if (validMaximum >= minimum) amount = Math.min(amount, validMaximum);
          quantity.value = Math.max(minimum, amount);
        }
        function sync(updateUrl = false) {
          const previousId = selected ? selected.id : null;
          selected = config.variants.find(v => v.options.length === optionValues.length && v.options.every((value, index) => value === optionValues[index]));
          variantSelect.value = selected ? selected.id : '';
          groups.forEach(group => {
            const index = Number(group.dataset.pcOptionIndex);
            group.querySelector('[data-pc-option-value]').textContent = displayOption(optionValues[index]);
            group.querySelectorAll('[data-pc-option]').forEach(button => {
              const active = button.dataset.pcOption === optionValues[index];
              const possible = config.variants.some(v => v.available && v.options.every((value, i) => value === (i === index ? button.dataset.pcOption : optionValues[i])));
              button.classList.toggle('is-active', active);
              button.classList.toggle('is-unavailable', !possible);
              button.setAttribute('aria-pressed', String(active));
              button.title = possible ? button.dataset.pcOption : button.dataset.pcOption + ' — unavailable for this combination';
              button.setAttribute('aria-label', possible ? displayOption(button.dataset.pcOption) : displayOption(button.dataset.pcOption) + ' — unavailable for this combination');
            });
          });
          const available = Boolean(selected && selected.available && (selected.max === null || selected.max >= selected.min));
          addButton.disabled = busy || !available;
          root.querySelector('[data-pc-add-label]').textContent = busy ? 'Adding…' : available ? 'Add to cart' : selected ? 'Sold out' : 'Unavailable combination';
          const stock = root.querySelector('[data-pc-stock]');
          stock.classList.toggle('is-unavailable', !available);
          const stockDot = document.createElement('span'); stockDot.setAttribute('aria-hidden', 'true');
          stock.replaceChildren(stockDot, document.createTextNode(available ? 'In stock' : selected ? 'Sold out' : 'Not available'));
          root.querySelector('[data-pc-price]').textContent = selected ? selected.price : 'Unavailable';
          root.querySelector('[data-pc-add-price]').textContent = selected ? selected.price : '';
          root.querySelectorAll('[data-pc-compare], [data-pc-add-compare]').forEach(node => { node.hidden = !selected || !selected.compare; node.textContent = selected && selected.compare ? selected.compare : ''; });
          const saving = root.querySelector('[data-pc-saving]'); saving.hidden = !selected || !selected.saving; saving.textContent = selected ? 'Save ' + selected.saving + '%' : '';
          if (selected) {
            quantity.min = selected.min; quantity.step = selected.step;
            if (selected.max !== null) quantity.max = selected.max; else quantity.removeAttribute('max');
            normaliseQuantity();
            if (selected.id !== previousId) showImage(selected.imageId || config.fallbackImageId);
          }
          root.querySelector('[data-pc-minus]').disabled = busy || !available || Number(quantity.value) <= Number(quantity.min);
          root.querySelector('[data-pc-plus]').disabled = busy || !available || (quantity.hasAttribute('max') && Number(quantity.value) + Number(quantity.step) > Number(quantity.max));
          if (updateUrl) {
            try { const url = new URL(window.location.href); if (selected) url.searchParams.set('variant', selected.id); else url.searchParams.delete('variant'); window.history.replaceState(window.history.state, '', url); } catch (_) { /* Native form still works without history access. */ }
          }
        }
        function displayOption(value) { return String(value || '').replace(/\s*\(only for(?: the)? 2 pro\)\s*/gi, '').trim(); }
        const dispatch = root.querySelector('[data-pc-dispatch]');
        if (dispatch) {
          const cutoffHour = Number(dispatch.dataset.cutoffHour);
          const formatter = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Copenhagen', weekday: 'short', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' });
          const partsFor = date => Object.fromEntries(formatter.formatToParts(date).map(part => [part.type, part.value]));
          const localTimeToUtc = (year, month, day, hour) => {
            const wanted = Date.UTC(year, month - 1, day, hour, 0, 0);
            let guess = wanted;
            for (let pass = 0; pass < 3; pass += 1) {
              const actual = partsFor(new Date(guess));
              const actualAsUtc = Date.UTC(Number(actual.year), Number(actual.month) - 1, Number(actual.day), Number(actual.hour), Number(actual.minute), Number(actual.second));
              guess += wanted - actualAsUtc;
            }
            return guess;
          };
          const updateDispatch = () => {
            if (!Number.isFinite(cutoffHour)) return;
            const now = new Date();
            const parts = partsFor(now);
            const isWorkingDay = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'].includes(parts.weekday);
            const secondsNow = Number(parts.hour) * 3600 + Number(parts.minute) * 60 + Number(parts.second);
            const dispatchesToday = isWorkingDay && cutoffHour * 3600 > secondsNow;
            let remaining;
            if (dispatchesToday) {
              remaining = cutoffHour * 3600 - secondsNow;
            } else {
              const daysUntilNextWorkingDay = { Mon: 1, Tue: 1, Wed: 1, Thu: 1, Fri: 3, Sat: 2, Sun: 1 }[parts.weekday];
              const targetDate = new Date(Date.UTC(Number(parts.year), Number(parts.month) - 1, Number(parts.day) + daysUntilNextWorkingDay));
              const target = localTimeToUtc(targetDate.getUTCFullYear(), targetDate.getUTCMonth() + 1, targetDate.getUTCDate(), cutoffHour);
              remaining = Math.max(0, Math.floor((target - now.getTime()) / 1000));
            }
            const timer = dispatch.querySelector('[data-pc-dispatch-time]');
            const lead = dispatch.querySelector('[data-pc-dispatch-lead]');
            const resultText = dispatch.querySelector('[data-pc-dispatch-result]');
            const hours = Math.floor(remaining / 3600);
            const minutes = Math.floor((remaining % 3600) / 60);
            const seconds = remaining % 60;
            lead.textContent = 'Order within';
            timer.textContent = [hours, minutes, seconds].map(value => String(value).padStart(2, '0')).join(':');
            timer.hidden = false;
            if (dispatchesToday) {
              resultText.textContent = "and we'll dispatch it today.";
              dispatch.classList.remove('is-next');
            } else {
              resultText.textContent = "and we'll dispatch it the next working day.";
              dispatch.classList.add('is-next');
            }
            dispatch.hidden = false;
          };
          try {
            updateDispatch();
            const dispatchInterval = window.setInterval(() => { if (!root.isConnected) window.clearInterval(dispatchInterval); else updateDispatch(); }, 1000);
          } catch (_) { dispatch.hidden = true; }
        }
        groups.forEach(group => group.addEventListener('click', event => { const button = event.target.closest('[data-pc-option]'); if (!button || busy) return; optionValues[Number(group.dataset.pcOptionIndex)] = button.dataset.pcOption; clearMessage(); sync(true); }));
        variantSelect.addEventListener('change', () => { const variant = config.variants.find(v => v.id === variantSelect.value); if (!variant) return; optionValues = [...variant.options]; clearMessage(); sync(true); });
        root.querySelectorAll('.pc-thumbnail').forEach(button => button.addEventListener('click', () => showImage(button.dataset.pcImageId)));
        root.querySelector('[data-pc-minus]').addEventListener('click', () => { quantity.value = Number(quantity.value) - Number(quantity.step); normaliseQuantity(); sync(); });
        root.querySelector('[data-pc-plus]').addEventListener('click', () => { quantity.value = Number(quantity.value) + Number(quantity.step); normaliseQuantity(); sync(); });
        quantity.addEventListener('change', () => { normaliseQuantity(); sync(); });
        form.addEventListener('submit', async event => {
          event.preventDefault();
          if (busy || !selected || !selected.available) return;
          normaliseQuantity(); if (!form.reportValidity()) return;
          busy = true; clearMessage(); sync(); form.setAttribute('aria-busy', 'true');
          try {
            const response = await fetch(config.addUrl, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
            const body = await response.json();
            if (!response.ok) throw new Error(body.description || body.message || 'This item could not be added. Please try again.');
            setMessage('Added to your bag.'); bagLink.hidden = false;
            const cartDrawer = document.getElementById('cart-drawer'); const cartTrigger = document.querySelector('[data-open-cart]');
            if (cartDrawer && cartTrigger) cartTrigger.click(); else window.location.assign(config.cartUrl);
          } catch (error) { setMessage(error.message || 'Please check your connection and try again.', true); }
          finally { busy = false; form.removeAttribute('aria-busy'); sync(); }
        });
        sync();
        if (config.initialImageId) showImage(config.initialImageId);
        root.querySelector('.pc-enhanced-options')?.removeAttribute('hidden'); root.classList.add('pc-enhanced');
      };
      document.addEventListener('shopify:section:load', event => event.target.querySelectorAll('[data-pc-product]').forEach(window.PodCoverProductInit));
    }
    document.querySelectorAll('[data-pc-product]').forEach(window.PodCoverProductInit);
  })();
</script>
