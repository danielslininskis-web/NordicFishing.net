{% liquid
  if collection == blank
    assign collection = section.settings.product_collection
  endif
  if collection == blank
    assign collection = collections['best-sellers']
  endif
  if collection == blank
    assign collection = collections['bestsellers']
  endif
  if collection == blank
    assign collection = collections['all']
  endif
  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign heading_id = 'pb-heading-' | append: section.id
%}

<section class="pb-page" id="pb-{{ section.id }}" aria-labelledby="{{ heading_id }}">
  <div class="pb-wrap">
    <nav class="pb-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      <span>Best sellers</span>
    </nav>

    <header class="pb-intro">
      <div>
        <p class="pb-eyebrow">PODCOVER / THE SHORTLIST</p>
        <h1 id="{{ heading_id }}">{{ section.settings.heading | escape }}</h1>
        <p class="pb-intro-copy">{{ section.settings.intro | escape }}</p>
      </div>
      <div class="pb-side-note">
        <span class="pb-note-label">SMALL DETAILS. EVERYDAY STYLE.</span>
        <p>Your AirPods.<br><em>A little more you.</em></p>
        <a href="#pb-products-{{ section.id }}">Explore the edit <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v16m-6-6 6 6 6-6"/></svg></a>
      </div>
    </header>

    {% if collection != blank %}
    {% paginate collection.products by section.settings.products_per_page %}
      {% liquid
        assign available_on_page = 0
        for item in collection.products
          if item.available
            assign available_on_page = available_on_page | plus: 1
          endif
        endfor
      %}

      {% if collection.products_count > 0 and available_on_page == 0 %}
        <div class="pb-stock-note" role="status">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <div><strong>Currently out of stock.</strong><p>The cases below are sold out. You can still explore their colours and details. Check back for availability.</p></div>
        </div>
      {% endif %}

      <div class="pb-toolbar" id="pb-products-{{ section.id }}">
        <p><strong>{{ collection.products_count }}</strong> {% if collection.products_count == 1 %}case{% else %}cases{% endif %} in the edit</p>
        {% if request.page_type == 'collection' %}
        <form class="pb-sort" method="get" action="{{ collection.url }}">
          <label for="pb-sort-{{ section.id }}">Sort by</label>
          <div class="pb-select">
            <select id="pb-sort-{{ section.id }}" name="sort_by" data-pb-sort>
              {% for option in collection.sort_options %}
                <option value="{{ option.value | escape }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name | escape }}</option>
              {% endfor %}
            </select>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4"/></svg>
          </div>
          <button type="submit" data-pb-sort-submit>Apply</button>
        </form>
        {% endif %}
      </div>

      <div class="pb-grid">
        {% for product in collection.products %}
          {% liquid
            assign product_image = product.featured_image
            assign product_alt = product_image.alt | default: product.title
            assign image_loading = 'lazy'
            if forloop.first
              assign image_loading = 'eager'
            endif
            assign product_handle = product.handle | downcase
            assign product_title = product.title | downcase
            assign is_cloud = false
            if product_handle contains 'blue-cloud' or product_title contains 'blue cloud'
              assign is_cloud = true
            endif
            assign colour_count = 0
            assign model_count = 0
            for product_option in product.options_with_values
              assign option_name = product_option.name | downcase
              if option_name contains 'colour' or option_name contains 'color'
                assign colour_count = product_option.values.size
              elsif option_name contains 'model' or option_name contains 'airpods'
                assign model_count = product_option.values.size
              endif
            endfor
          %}

          <article class="pb-card{% if is_cloud %} pb-card-cloud{% endif %}">
            <a class="pb-photo" href="{{ product.url | within: collection }}" aria-label="Explore {{ product.title | escape }}">
              <span class="pb-photo-label">{% if is_cloud %}THE BLUE CLOUD EDIT{% else %}THE COLOUR EDIT{% endif %}</span>
              {% unless product.available %}<span class="pb-stock-badge">Out of stock</span>{% endunless %}
              {% if product_image %}
                {{ product_image | image_url: width: 1400 | image_tag: class: 'pb-product-image', loading: image_loading, widths: '320, 480, 640, 900, 1200, 1400', sizes: '(min-width: 1000px) 44vw, (min-width: 700px) 46vw, 90vw', alt: product_alt }}
              {% else %}
                <div class="pb-photo-empty" aria-hidden="true">
                  <svg viewBox="0 0 280 220" fill="none"><rect x="61" y="71" width="158" height="107" rx="39"/><path d="M72 81c4-30 24-45 68-45s64 15 68 45M61 111h158"/><circle cx="140" cy="144" r="4"/></svg>
                </div>
              {% endif %}
              <span class="pb-photo-foot">{% if is_cloud %}A LITTLE PIECE OF SKY.{% else %}COLOUR FOR YOUR DAILY ROTATION.{% endif %}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M8 5h11v11"/></svg></span>
            </a>

            <div class="pb-card-copy">
              <div class="pb-card-title">
                <h2><a href="{{ product.url | within: collection }}">{{ product.title | escape }}</a></h2>
                <p class="pb-price">{% if product.price_varies %}<span>From</span> {% endif %}{{ product.price | money }}</p>
              </div>
              <p class="pb-product-copy">{% if is_cloud %}Cloudlike blue. A glossy finish. A little silver shine.{% else %}Find your everyday shade and make your essentials feel like you.{% endif %}</p>
              <div class="pb-card-bottom">
                <div class="pb-facts">
                  {% if model_count > 0 %}<span>{{ model_count }} AirPods {% if model_count == 1 %}fit{% else %}fits{% endif %}</span>{% endif %}
                  {% if colour_count > 0 %}<span>{{ colour_count }} {% if colour_count == 1 %}colour{% else %}colours{% endif %}</span>{% endif %}
                  {% if model_count == 0 and colour_count == 0 %}<span>View the details</span>{% endif %}
                </div>
                <a class="pb-case-link" href="{{ product.url | within: collection }}">{% if product.available %}Choose your case{% else %}Explore the case{% endif %}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5"/></svg></a>
              </div>
            </div>
          </article>
        {% else %}
          <div class="pb-empty">
            <p class="pb-eyebrow">THE NEXT EDIT</p>
            <h2>A little more style.<br>Coming your way.</h2>
            <p>There are no cases in this collection yet. Explore the rest of PodCover while this edit takes shape.</p>
            <a class="pb-button" href="{{ routes.all_products_collection_url }}">Explore all cases <span aria-hidden="true">↗</span></a>
          </div>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="pb-pagination" aria-label="Best sellers pages">{{ paginate | default_pagination }}</nav>
      {% endif %}
    {% endpaginate %}
    {% else %}
      <div class="pb-grid" id="pb-products-{{ section.id }}">
        <div class="pb-empty">
          <p class="pb-eyebrow">THE NEXT EDIT</p>
          <h2>A little more style.<br>Coming your way.</h2>
          {% if request.design_mode %}
            <p>Select a product collection in this section's settings to show your cases here.</p>
          {% else %}
            <p>Check back soon for the next PodCover edit.</p>
          {% endif %}
          <a class="pb-button" href="{{ routes.all_products_collection_url }}">Explore all cases <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    {% endif %}

    <section class="pb-closing" aria-labelledby="pb-closing-{{ section.id }}">
      <div><p class="pb-eyebrow">YOUR EVERYDAY, RECONSIDERED.</p><h2 id="pb-closing-{{ section.id }}">The detail<br>that goes <em>everywhere.</em></h2></div>
      <div><p>For your morning playlist, your coffee run and everything in between. Find a case that fits your AirPods and your style.</p><a class="pb-button" href="{{ routes.all_products_collection_url }}">Explore the full collection <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M8 5h11v11"/></svg></a></div>
    </section>
  </div>
</section>

<style>
  .pb-page{--pb-ink:#182c3a;--pb-muted:#657681;--pb-line:#dce3e7;color:var(--pb-ink);background:#fff}
  .pb-page *{box-sizing:border-box}.pb-page a{color:inherit;text-decoration:none}.pb-page p,.pb-page h1,.pb-page h2{margin:0}.pb-page svg{stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}
  .pb-wrap{width:90%;max-width:1296px;margin:0 auto}.pb-breadcrumb{display:flex;gap:10px;padding:27px 0;font-size:10px;line-height:1.6;color:var(--pb-muted)}.pb-breadcrumb a:hover{text-decoration:underline}
  .pb-intro{padding:48px 0 69px;display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,.6fr);gap:70px;align-items:end}.pb-eyebrow,.pb-note-label{font-size:9px;font-weight:700;letter-spacing:.19em;line-height:1.6}
  .pb-intro h1{font-size:clamp(58px,8.2vw,118px);font-weight:560;line-height:.95;letter-spacing:-.075em;margin:21px 0 25px}.pb-intro-copy{max-width:550px;font-size:14px;line-height:1.8;color:var(--pb-muted)}
  .pb-side-note{border-left:1px solid var(--pb-line);padding-left:32px}.pb-note-label{color:var(--pb-muted);font-size:8px}.pb-side-note>p{font-size:clamp(22px,2.5vw,34px);line-height:1.15;letter-spacing:-.045em;margin:15px 0 23px}.pb-side-note em,.pb-closing em{font-family:Georgia,serif;font-weight:400;font-style:italic;color:#477a99}.pb-side-note>a{display:inline-flex;gap:24px;align-items:center;font-size:10px;font-weight:650}.pb-side-note svg{width:17px;height:17px}
  .pb-stock-note{display:flex;align-items:center;gap:14px;padding:18px 22px;margin:0 0 33px;border-radius:12px;border:1px solid #e4dfd5;background:#f7f5ef;color:#5b594e}.pb-stock-note>svg{width:25px;height:25px;color:#8b826b}.pb-stock-note strong{font-size:12px;line-height:1.5}.pb-stock-note p{font-size:11px;line-height:1.65;margin-top:3px}
  .pb-toolbar{display:flex;justify-content:space-between;align-items:center;gap:20px;padding:0 0 19px;border-bottom:1px solid var(--pb-line);scroll-margin-top:110px}.pb-toolbar>p{font-size:11px;color:var(--pb-muted)}.pb-toolbar>p strong{color:var(--pb-ink);font-size:16px;margin-right:5px}.pb-sort{display:flex;align-items:center;gap:12px;font-size:11px}.pb-sort label{font-weight:650}.pb-select{position:relative}.pb-select select{min-height:42px;min-width:174px;max-width:100%;border:1px solid var(--pb-line);border-radius:8px;padding:10px 35px 10px 12px;appearance:none;background:white;color:var(--pb-ink);font-size:11px}.pb-select svg{width:15px;height:15px;position:absolute;right:11px;top:50%;transform:translateY(-50%);pointer-events:none}.pb-sort>button{padding:10px 12px;border:1px solid var(--pb-line);border-radius:8px;background:#fff;color:var(--pb-ink);font-size:11px}.pb-sort>button[hidden]{display:none}
  .pb-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:65px 25px;padding:30px 0 90px}.pb-card{min-width:0}.pb-photo{position:relative;display:grid;place-items:center;aspect-ratio:1.13;border-radius:17px;overflow:hidden;background:#f1f3f2}.pb-card-cloud .pb-photo{background:#f6f8fc}.pb-product-image{width:100%;height:100%;object-fit:contain;display:block;transition:transform .65s cubic-bezier(.2,.75,.2,1)}.pb-photo:hover .pb-product-image{transform:scale(1.025)}
  .pb-photo-label,.pb-stock-badge{position:absolute;top:18px;z-index:1;padding:8px 10px;border-radius:5px;font-size:8px;line-height:1.5}.pb-photo-label{left:18px;background:#ffffffeb;letter-spacing:.14em}.pb-stock-badge{right:18px;background:#202321;color:white;font-weight:650}.pb-photo-foot{position:absolute;bottom:17px;left:18px;right:18px;display:flex;align-items:center;justify-content:space-between;gap:15px;font-size:7px;letter-spacing:.13em}.pb-photo-foot svg{width:21px;height:21px;padding:2px}.pb-photo-empty{width:65%;color:#9eabb0}.pb-photo-empty svg{width:100%;stroke-width:2}
  .pb-card-copy{padding:21px 2px 0}.pb-card-title{display:flex;justify-content:space-between;gap:18px;align-items:start}.pb-card-title h2{font-family:inherit;max-width:430px;font-size:clamp(20px,2.05vw,28px);font-weight:600;letter-spacing:-.045em;line-height:1.18}.pb-price{font-size:14px;line-height:1.6;font-weight:700;white-space:nowrap}.pb-price span{font-size:9px;font-weight:400;color:var(--pb-muted)}.pb-product-copy{color:var(--pb-muted);font-size:11px;line-height:1.7;margin-top:12px!important}.pb-card-bottom{border-top:1px solid var(--pb-line);padding-top:17px;margin-top:22px;display:flex;justify-content:space-between;align-items:center;gap:18px}.pb-facts{display:flex;flex-wrap:wrap;gap:7px}.pb-facts span{padding:6px 9px;background:#f0f3f5;border-radius:999px;color:var(--pb-muted);font-size:9px;line-height:1.4}.pb-case-link{display:inline-flex;gap:13px;align-items:center;font-size:10px;line-height:1.5;font-weight:650;flex-shrink:0}.pb-case-link svg{width:17px;height:17px;transition:transform .2s}.pb-case-link:hover svg{transform:translateX(3px)}
  .pb-button{display:inline-flex;justify-content:space-between;align-items:center;gap:32px;min-height:50px;padding:15px 19px;border:1px solid var(--pb-ink);border-radius:8px;background:var(--pb-ink);color:white!important;font-size:11px;font-weight:650;line-height:1.5;transition:background .2s,transform .2s}.pb-button>svg{width:18px;height:18px}.pb-button:hover{background:#304b59;transform:translateY(-1px)}.pb-empty{grid-column:1/-1;max-width:700px;padding:45px 0}.pb-empty h2{font-size:clamp(35px,5vw,65px);font-weight:560;line-height:1.06;letter-spacing:-.06em;margin:18px 0}.pb-empty>p:not(.pb-eyebrow){max-width:480px;font-size:14px;line-height:1.75;color:var(--pb-muted);margin-bottom:23px}
  .pb-pagination{display:flex;gap:7px;flex-wrap:wrap;justify-content:center;margin:-35px 0 65px}.pb-pagination .page,.pb-pagination .next,.pb-pagination .prev{display:inline-flex;align-items:center;justify-content:center;min-width:38px;min-height:38px;padding:7px 11px;border:1px solid var(--pb-line);border-radius:8px;font-size:11px}.pb-pagination .current{background:var(--pb-ink);color:white}
  .pb-closing{display:grid;grid-template-columns:1.3fr 1fr;gap:75px;padding:50px 55px;margin-bottom:90px;border:1px solid #e0e7e9;border-radius:16px;background:#f2f6f7}.pb-closing h2{font-size:clamp(35px,4.2vw,58px);font-weight:560;letter-spacing:-.065em;line-height:1.03;margin-top:17px}.pb-closing>div:last-child{align-self:end}.pb-closing>div>p:not(.pb-eyebrow){font-size:12px;line-height:1.8;color:var(--pb-muted);max-width:390px;margin-bottom:25px}
  .pb-page a:focus-visible,.pb-page select:focus-visible,.pb-page button:focus-visible{outline:2px solid #477a99;outline-offset:4px}
  @media(max-width:999px){.pb-intro{gap:35px}.pb-side-note{padding-left:23px}.pb-card-title{flex-direction:column;gap:9px}.pb-card-bottom{align-items:start;flex-direction:column;gap:14px}.pb-closing{gap:35px;padding:38px}}
  @media(max-width:699px){.pb-breadcrumb{padding:20px 0;font-size:9px}.pb-intro{grid-template-columns:1fr;padding:27px 0 38px;gap:25px}.pb-intro h1{font-size:clamp(52px,14.8vw,83px);margin:18px 0}.pb-intro-copy{font-size:12px}.pb-side-note{border-left:0;border-top:1px solid var(--pb-line);padding:18px 0 0}.pb-side-note .pb-note-label,.pb-side-note>p{display:none}.pb-stock-note{padding:15px;margin-bottom:25px;gap:11px}.pb-stock-note p{font-size:10px}.pb-toolbar{gap:15px;align-items:end}.pb-toolbar>p{font-size:10px;max-width:85px;line-height:1.6}.pb-toolbar>p strong{display:block;font-size:18px}.pb-sort{flex-wrap:wrap;justify-content:flex-end;gap:5px 9px}.pb-sort label{font-size:9px}.pb-select select{min-width:145px;min-height:40px;font-size:10px}.pb-grid{grid-template-columns:1fr;gap:45px;padding:23px 0 55px}.pb-photo{aspect-ratio:1.08;border-radius:13px}.pb-photo-label,.pb-stock-badge{top:13px;font-size:7px}.pb-photo-label{left:13px}.pb-stock-badge{right:13px}.pb-photo-foot{left:13px;right:13px;bottom:13px;font-size:6px}.pb-card-copy{padding-top:18px}.pb-card-title h2{font-size:24px}.pb-price{font-size:14px}.pb-product-copy{font-size:11px}.pb-card-bottom{flex-direction:row;align-items:center;gap:12px}.pb-facts span{font-size:8px;padding:5px 8px}.pb-case-link{font-size:9px;gap:7px}.pb-closing{grid-template-columns:1fr;gap:25px;padding:28px 22px;margin-bottom:60px;border-radius:13px}.pb-closing h2{font-size:38px}.pb-closing>div>p:not(.pb-eyebrow){font-size:11px}.pb-button{font-size:10px;gap:20px}.pb-pagination{margin:-15px 0 40px}}
  @media(max-width:359px){.pb-card-bottom{flex-direction:column;align-items:start}.pb-photo-label{max-width:55%}.pb-closing h2{font-size:33px}}
  @media(prefers-reduced-motion:reduce){.pb-page *{transition:none!important;scroll-behavior:auto!important}.pb-photo:hover .pb-product-image,.pb-case-link:hover svg,.pb-button:hover{transform:none}}
</style>

<script>
  (() => {
    const initBestSellers = root => {
      if (!root || root.dataset.pbReady === 'true') return;
      root.dataset.pbReady = 'true';
      const sort = root.querySelector('[data-pb-sort]');
      if (!sort || !sort.form) return;
      sort.addEventListener('change', () => sort.form.requestSubmit());
      root.querySelector('[data-pb-sort-submit]').hidden = true;
    };
    initBestSellers(document.getElementById('pb-{{ section.id }}'));
    document.addEventListener('shopify:section:load', event => {
      const root = event.target.matches('.pb-page') ? event.target : event.target.querySelector('.pb-page');
      initBestSellers(root);
    });
  })();
</script>

{% schema %}
{
  "name": "PodCover best sellers",
  "settings": [
    { "type": "collection", "id": "product_collection", "label": "Product collection", "info": "On a regular page, choose your Best Sellers collection. Collection pages use their own products." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "A small detail. A whole new mood. Explore the PodCover edits made for your daily rotation." },
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 4, "max": 24, "step": 4, "default": 12 }
  ]
}
{% endschema %}
