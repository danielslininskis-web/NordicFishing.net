{% liquid
  assign bestsellers_url = pages['best-sellers'].url
  assign about_url = pages['about'].url
  if bestsellers_url == blank
    assign bestsellers_url = routes.root_url | append: 'pages/best-sellers'
  endif
  if about_url == blank
    assign about_url = routes.root_url | append: 'pages/about'
  endif
%}
<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="{{ routes.root_url }}" aria-label="PodCover home">PodCover</a>
    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="{{ routes.all_products_collection_url }}">Shop</a>
      <a href="{{ routes.collections_url }}">Collections</a>
      <a href="{{ bestsellers_url }}">Bestsellers</a>
      <a href="{{ about_url }}">About</a>
    </nav>
    <div class="header-actions">
      <button class="icon-btn" type="button" data-search-toggle aria-label="Open search" aria-expanded="false" aria-controls="HeaderSearch-{{ section.id }}">
        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="10.8" cy="10.8" r="6.6"/><path d="m16 16 5 5"/></svg>
      </button>
      <a class="icon-btn account" href="{{ routes.account_url }}" aria-label="Account">
        <svg aria-hidden="true" viewBox="0 0 24 24"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 21c0-5 15-5 15 0"/></svg>
      </a>
      <button class="icon-btn" type="button" data-open-cart aria-label="Open shopping bag" aria-haspopup="dialog" aria-expanded="false" aria-controls="cart-drawer">
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 8h16l-1 13H5L4 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
        <span class="cart-bubble" data-cart-count>{{ cart.item_count }}</span>
      </button>
      <button class="icon-btn mobile-menu-btn" type="button" data-menu-toggle aria-label="Open navigation" aria-expanded="false" aria-controls="HeaderMobileNav-{{ section.id }}">☰</button>
    </div>
  </div>
  <form id="HeaderSearch-{{ section.id }}" class="search-bar" action="{{ routes.search_url }}" method="get" role="search" hidden>
    <input type="search" name="q" placeholder="Search the edit…" aria-label="Search products" required>
    <input type="hidden" name="type" value="product">
    <button type="submit">Search →</button>
  </form>
  <nav id="HeaderMobileNav-{{ section.id }}" class="mobile-nav" hidden aria-label="Mobile navigation">
    <a href="{{ routes.all_products_collection_url }}">Shop all</a>
    <a href="{{ routes.collections_url }}">Collections</a>
    <a href="{{ bestsellers_url }}">Bestsellers</a>
    <a href="{{ about_url }}">Our story</a>
    <a href="{{ routes.account_url }}">Account</a>
  </nav>
</header>
{% schema %}
{"name":"Header","settings":[]}
{% endschema %}
