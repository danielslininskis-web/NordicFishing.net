{% liquid
  assign contact_url = pages['podcover-contact'].url | default: '/pages/podcover-contact'
%}
<section class="ps-shipping" aria-labelledby="ps-title-{{ section.id }}">
  <header class="ps-hero"><div><span class="ps-eyebrow">PODCOVER / SHIPPING</span><h1 id="ps-title-{{ section.id }}">Shipping,<br><em>made simple.</em></h1><p>Your PodCover case, packed with care. The details you need before it leaves us.</p></div></header>
  <div class="ps-facts">
    <article><span>01</span><h2>Free standard shipping</h2><p>To destinations offered at checkout. Any optional upgrade is priced before you pay.</p></article>
    <article><span>02</span><h2>Clear dispatch details</h2><p>The product page shows whether same-day dispatch is offered for your available case.</p></article>
    <article><span>03</span><h2>Order updates</h2><p>Confirmation and dispatch information go to the email address you use at checkout.</p></article>
  </div>
  <div class="ps-process">
    <div><span class="ps-eyebrow">THE PROCESS</span><h2>From us<br>to <em>you.</em></h2></div>
    <div class="ps-steps">
      <article><span>01</span><div><h3>You choose your case</h3><p>Select the model and colour that match your AirPods. Available destinations and shipping options are shown before you complete checkout. Sold-out combinations cannot be ordered.</p></div></article>
      <article><span>02</span><div><h3>We prepare your order</h3><p>Where same-day dispatch is offered, available items ordered before the displayed cutoff, normally 15:00 Copenhagen time Monday–Friday, are dispatched that day. Orders after the cutoff or at weekends go on the next working day. The dispatch date shown on the product page accounts for weekends and scheduled closures.</p><p>Dispatch means handing the parcel to the carrier. It does not promise same-day delivery.</p></div></article>
      <article><span>03</span><div><h3>Your parcel is on its way</h3><p>Delivery depends on the carrier service and destination. Any estimates shown at checkout or in your dispatch confirmation are estimates unless a fixed date is expressly agreed. Tracking information is included where the selected service provides it.</p></div></article>
    </div>
  </div>
  <div class="ps-details">
    <article><h2>Check your address</h2><p>Please enter a complete delivery address and a working email. If you spot a mistake, contact us promptly. We will try to help, but cannot guarantee changes after dispatch.</p></article>
    <article><h2>Parcel delayed or missing?</h2><p>Check any tracking information, then contact us with your order number. We will look into it with the carrier. Your statutory rights for delayed, damaged, or missing delivery remain unaffected.</p></article>
  </div>
  <div class="ps-contact"><div><span class="ps-eyebrow">NEED A HAND?</span><h2>Questions about<br>your order?</h2><p>Send us your order number and tell us what you need.</p></div><a href="{{ contact_url }}">Contact PodCover <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div>
</section>
<style>
.ps-shipping{background:#fff;color:#182c3a}.ps-shipping *,.ps-shipping *::before,.ps-shipping *::after{box-sizing:border-box}.ps-shipping a{color:inherit;text-decoration:none}.ps-shipping h1,.ps-shipping h2,.ps-shipping h3{margin:0;font-family:Manrope,Arial,sans-serif;font-weight:500;letter-spacing:-.05em;line-height:1.08}.ps-shipping h1{font-size:clamp(56px,7vw,100px)}.ps-shipping h1 em,.ps-shipping h2 em{font-family:Georgia,'Times New Roman',serif;font-weight:400;color:#397599}.ps-shipping p{color:#526575;font-size:15px;line-height:1.85}.ps-eyebrow{display:block;margin-bottom:24px;font-size:11px;font-weight:700;letter-spacing:.16em;line-height:1.6}.ps-hero{background:#f1f4f8;padding:80px 6%}.ps-hero>div{max-width:1350px;margin:auto}.ps-hero p{max-width:410px;margin:28px 0 0;font-size:16px}.ps-facts{display:grid;grid-template-columns:repeat(3,1fr);gap:40px;max-width:1350px;margin:auto;padding:65px 6%;border-bottom:1px solid #cbd5dc}.ps-facts article>span{display:block;margin-bottom:28px;font-size:12px;color:#526575}.ps-facts h2{font-size:25px}.ps-process{display:grid;grid-template-columns:.7fr 1.3fr;gap:10%;max-width:1350px;margin:auto;padding:85px 6%}.ps-process h2{font-size:clamp(40px,4.5vw,64px)}.ps-steps article{display:grid;grid-template-columns:35px 1fr;gap:20px;padding:28px 0;border-top:1px solid #cbd5dc}.ps-steps article>span{color:#397599;font-size:12px}.ps-steps h3{font-size:27px}.ps-steps p{margin:18px 0 0}.ps-details{display:grid;grid-template-columns:1fr 1fr;gap:70px;max-width:1190px;margin:0 auto 85px;padding:45px 5%;background:#f1f4f8}.ps-details h2{font-size:28px}.ps-contact{display:flex;align-items:center;justify-content:space-between;gap:45px;max-width:1350px;margin:auto;padding:0 6% 90px}.ps-contact h2{font-size:clamp(34px,4vw,56px)}.ps-contact>a{display:inline-flex;align-items:center;justify-content:space-between;gap:40px;min-height:48px;padding:17px 24px;background:#182c3a;color:#fff;font-size:13px;font-weight:700}.ps-shipping a:focus-visible{outline:2px solid #397599;outline-offset:5px}@media(max-width:760px){.ps-hero{padding:65px 6%}.ps-shipping h1{font-size:clamp(48px,13vw,72px)}.ps-facts{grid-template-columns:1fr;gap:25px;padding:45px 6%}.ps-facts article>span{margin-bottom:14px}.ps-process{grid-template-columns:1fr;gap:35px;padding:60px 6%}.ps-steps article{grid-template-columns:25px 1fr;gap:12px}.ps-steps h3{font-size:25px}.ps-details{grid-template-columns:1fr;gap:30px;margin:0 6% 60px;padding:35px 8%}.ps-contact{align-items:flex-start;flex-direction:column;padding-bottom:65px;gap:25px}.ps-contact>a{width:100%}}
</style>
{% schema %}
{"name":"PodCover shipping","settings":[]}
{% endschema %}
