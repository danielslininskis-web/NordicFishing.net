{% liquid
  assign contact_form_id = 'PodCoverContact-' | append: section.id
  assign shipping_url = pages['podcover-shipping'].url | default: '/pages/podcover-shipping'
  assign refund_url = pages['refund-policy'].url | default: '/pages/refund-policy'
%}

<section class="pc-contact" aria-labelledby="pc-contact-title-{{ section.id }}">
  <header class="pc-contact-hero">
    <div>
      <span class="pc-contact-eyebrow">PODCOVER / CONTACT</span>
      <h1 id="pc-contact-title-{{ section.id }}">Let’s talk.</h1>
      <p>Questions about your order, a product, or just need a hand? Send us a message.</p>
    </div>
  </header>
  <div class="pc-contact-content">
    <aside class="pc-contact-aside" aria-label="Contact information">
      <span class="pc-contact-eyebrow">GET IN TOUCH</span>
      <h2>We’re here<br>to help.</h2>
      <p>Tell us what you need and include your order number if your message is about an existing order.</p>
      <a class="pc-contact-email" href="mailto:podcoverhelp@gmail.com">podcoverhelp@gmail.com</a>
      <div class="pc-contact-note">
        <span aria-hidden="true">✦</span>
        <p>For shipping and returns, you can also check our <a href="{{ shipping_url }}">shipping information</a> and <a href="{{ refund_url }}">return policy</a>.</p>
      </div>
    </aside>
    <div class="pc-contact-form-wrap">
      {% form 'contact', id: contact_form_id, class: 'pc-contact-form' %}
        {% if form.posted_successfully? %}
          <div class="pc-contact-success" role="status" tabindex="-1">
            <h3>Message sent.</h3>
            <p>Thanks for contacting PodCover. We’ll reply to the email address you provided.</p>
          </div>
        {% else %}
          {% if form.errors %}
            <div class="pc-contact-errors" id="{{ contact_form_id }}-errors" role="alert">
              <h3>Please check your message.</h3>
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
          <p class="pc-contact-required">All fields are required except the order number.</p>
          <div class="pc-contact-fields">
            <div class="pc-contact-field">
              <label for="{{ contact_form_id }}-name">Name</label>
              <input id="{{ contact_form_id }}-name" type="text" name="contact[name]" autocomplete="name" value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}" required>
            </div>
            <div class="pc-contact-field">
              <label for="{{ contact_form_id }}-email">Email</label>
              <input id="{{ contact_form_id }}-email" type="email" name="contact[email]" autocomplete="email" autocapitalize="off" spellcheck="false" value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}" {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="{{ contact_form_id }}-errors"{% endif %} required>
            </div>
          </div>
          <div class="pc-contact-field">
            <label for="{{ contact_form_id }}-order">Order number <span>(optional)</span></label>
            <input id="{{ contact_form_id }}-order" type="text" name="contact[order_number]" autocomplete="off" placeholder="For example, #1001" value="{{ form.order_number | escape }}">
          </div>
          <div class="pc-contact-field">
            <label for="{{ contact_form_id }}-message">How can we help?</label>
            <textarea id="{{ contact_form_id }}-message" name="contact[body]" rows="7" required>{{ form.body | escape }}</textarea>
          </div>
          <button class="pc-contact-button" type="submit">Send message <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 19 19 5M5 5h14v14"/></svg></button>
          <p class="pc-contact-privacy">We use your details to respond to your message. Read our <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">privacy policy</a>.</p>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

<style>
.pc-contact{background:#fff;color:#182c3a}
.pc-contact *,.pc-contact *::before,.pc-contact *::after{box-sizing:border-box}
.pc-contact a{color:inherit}
.pc-contact-hero{display:flex;align-items:end;padding:85px 6%;background:#f1f4f8}
.pc-contact-hero>div{width:100%;max-width:1350px;margin:0 auto}
.pc-contact-eyebrow{display:block;margin-bottom:20px;font-size:11px;font-weight:700;letter-spacing:.18em;line-height:1.6}
.pc-contact h1,.pc-contact h2{margin:0;font-family:Manrope,Arial,sans-serif;font-weight:500;letter-spacing:-.065em;line-height:1.04}
.pc-contact h1{font-size:clamp(64px,8vw,116px)}
.pc-contact-hero p{max-width:405px;margin:28px 0 0;color:#526575;font-size:16px;line-height:1.8}
.pc-contact-content{display:grid;grid-template-columns:.75fr 1.25fr;gap:clamp(35px,7vw,100px);max-width:1350px;margin:0 auto;padding:100px 6% 120px}
.pc-contact-content>*{min-width:0}
.pc-contact-aside h2{font-size:clamp(48px,4.5vw,76px)}
.pc-contact-aside>p{max-width:330px;margin:25px 0;color:#526575;font-size:15px;line-height:1.8}
.pc-contact-email{display:inline-block;font-size:14px;text-underline-offset:5px;overflow-wrap:anywhere}
.pc-contact-note{display:flex;gap:12px;max-width:330px;margin-top:35px;padding-top:22px;border-top:1px solid #cbd5dc}
.pc-contact-note>span{color:#397599}
.pc-contact-note p{margin:0;color:#526575;font-size:13px;line-height:1.8}
.pc-contact-note a,.pc-contact-privacy a{text-underline-offset:3px}
.pc-contact-form-wrap{padding:clamp(24px,4vw,58px);background:#f1f4f8}
.pc-contact-fields{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.pc-contact-field{min-width:0;margin-bottom:24px}
.pc-contact-field label{display:block;margin-bottom:10px;font-size:13px;font-weight:700}
.pc-contact-field label span{color:#526575;font-weight:400}
.pc-contact-field input,.pc-contact-field textarea{width:100%;min-width:0;border:1px solid #8798a5;border-radius:0;background:#fff;padding:14px;color:#182c3a;font:inherit;font-size:16px;line-height:1.5}
.pc-contact-field input::placeholder{color:#526575;opacity:1}
.pc-contact-field textarea{resize:vertical;min-height:150px}
.pc-contact-required,.pc-contact-privacy{margin:0 0 24px;color:#526575;font-size:12px;line-height:1.8}
.pc-contact-privacy{margin:20px 0 0}
.pc-contact-button{display:inline-flex;align-items:center;justify-content:space-between;gap:45px;min-height:48px;border:0;padding:16px 24px;background:#182c3a;color:#fff;font:inherit;font-size:13px;font-weight:700;cursor:pointer;transition:background .2s,transform .2s}
.pc-contact-button:hover{background:#30526a;transform:translateY(-2px)}
.pc-contact-success,.pc-contact-errors{padding:24px;background:#fff;border-left:3px solid #397599;overflow-wrap:anywhere}
.pc-contact-errors{margin-bottom:24px;border-color:#9b2626}
.pc-contact-success h3,.pc-contact-errors h3{margin:0;font-size:20px}
.pc-contact-success p,.pc-contact-errors ul{margin:12px 0 0;color:#526575;font-size:15px;line-height:1.8}
.pc-contact a:focus-visible,.pc-contact input:focus-visible,.pc-contact textarea:focus-visible,.pc-contact button:focus-visible{outline:2px solid #397599;outline-offset:4px}
@media(max-width:800px){.pc-contact-hero{padding:65px 6%}.pc-contact h1{font-size:clamp(48px,13vw,74px)}.pc-contact-content{grid-template-columns:1fr;gap:45px;padding:65px 6% 75px}.pc-contact-fields{grid-template-columns:1fr;gap:0}.pc-contact-button{width:100%}}
@media(prefers-reduced-motion:reduce){.pc-contact-button{transition:none}}
</style>

{% schema %}
{"name":"PodCover contact","settings":[]}
{% endschema %}
