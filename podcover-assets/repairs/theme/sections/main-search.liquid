<section class="section-wrap collection-page pc-search" aria-labelledby="SearchHeading-{{ section.id }}">
  <span class="eyebrow">PODCOVER / DISCOVER</span>
  <h1 id="SearchHeading-{{ section.id }}">Find your everyday.</h1>
  <form action="{{ routes.search_url }}" method="get" class="search-page-form" role="search">
    <label class="pc-search-label" for="SearchInput-{{ section.id }}">Search products</label>
    <input id="SearchInput-{{ section.id }}" type="search" name="q" value="{{ search.terms | escape }}" placeholder="What are you looking for?" required>
    <input type="hidden" name="type" value="product">
    <button type="submit" class="pill dark">Search ↗</button>
  </form>
  {% if search.performed %}
    {% paginate search.results by 24 %}
      <p class="pc-search-results">{{ search.results_count }} {% if search.results_count == 1 %}result{% else %}results{% endif %} for “{{ search.terms | escape }}”</p>
      {% if search.results_count > 0 %}
        <div class="product-grid">
          {% for result in search.results %}
            {% if result.object_type == 'product' %}{% render 'product-card', product: result %}{% endif %}
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}
          <nav class="pc-search-pagination" aria-label="Search result pages">{{ paginate | default_pagination }}</nav>
        {% endif %}
      {% else %}
        <div class="pc-search-empty">
          <h2>No matches just yet.</h2>
          <p>Try a colour, “Blue Cloud”, or “AirPods”.</p>
          <a class="pill dark" href="{{ routes.all_products_collection_url }}">Explore all cases ↗</a>
        </div>
      {% endif %}
    {% endpaginate %}
  {% else %}
    <p class="pc-search-results">Discover Blue Cloud and the Colour Edit. Search by colour, case, or AirPods model.</p>
  {% endif %}
</section>
<style>
  .pc-search h1{max-width:920px;font-size:clamp(44px,7vw,100px)}
  .pc-search .search-page-form{flex-wrap:wrap;gap:14px;align-items:center}
  .pc-search-label{flex-basis:100%;font-size:13px;font-weight:600}
  .pc-search-results{color:#52616d;line-height:1.7;margin:30px 0}
  .pc-search .card-image{position:relative;aspect-ratio:1;padding:20px;background:#f3f6f9;overflow:hidden}
  .pc-search .card-image img{width:100%;height:100%;object-fit:contain}
  .card-stock-badge{position:absolute;left:18px;top:18px;display:inline-block;padding:8px 12px;background:#fff;color:#253746;font-size:12px;font-weight:600;line-height:1.4;border:1px solid #d4dde4;border-radius:999px}
  .card-image-missing{display:flex;width:100%;height:100%;flex-direction:column;align-items:center;justify-content:center;gap:16px;text-align:center;padding:24px;color:#44545f}
  .card-image-missing span:first-child{font-size:23px;letter-spacing:.12em}
  .card-stock-note{color:#52616d}
  .pc-search .card-meta h3{font-size:20px;line-height:1.3;letter-spacing:-.035em}
  .pc-search .card-meta p{font-size:14px;line-height:1.5}
  .pc-search .card-meta s{color:#52616d;font-size:13px;margin-left:6px}
  .pc-search-empty{padding:50px 0}
  .pc-search-empty h2{font-size:clamp(30px,4vw,50px)}
  .pc-search-empty p{color:#52616d;line-height:1.7;margin-bottom:25px}
  .pc-search-pagination{margin-top:50px;text-align:center}
  .pc-search-pagination span{display:inline-flex;align-items:center;justify-content:center;min-height:44px;min-width:44px;padding:8px;border:1px solid #c8d1d8;border-radius:8px;margin:3px}
  .pc-search-pagination .current{background:#182c3a;color:#fff;border-color:#182c3a}
  @media(max-width:600px){.pc-search{padding-top:55px;padding-bottom:65px}.pc-search .search-page-form input{width:100%;flex-basis:100%}.pc-search .search-page-form button{padding:13px 23px}.pc-search .product-grid{grid-template-columns:1fr}.pc-search .card-image{max-height:440px}.pc-search .card-meta h3{font-size:19px}}
</style>
{% schema %}
{"name":"Search","settings":[]}
{% endschema %}
